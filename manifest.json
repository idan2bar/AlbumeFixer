{
  "name": "Albume Fixer",
  "description": "Quality-of-life fixes and shortcuts for the Albume editor.",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://editor.albume.co.il/*"],
      "js": ["content.js", "size-clipboard.js", "multi-align.js", "remove-all.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://editor.albume.co.il/*"],
      "js": ["canvas-bridge.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
